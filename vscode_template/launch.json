{
    // openocd comes from the Pico extension (see tasks.json). svdFile cannot: the
    // extension's getSVDPath only answers for Rust projects, so the SDK version
    // stays spelled out here and must match sdkVersion in CMakeLists.txt.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Pico Debug",
            "cwd": "${command:raspberry-pi-pico.getOpenOCDRoot}/scripts",
            "executable": "${command:raspberry-pi-pico.launchTargetPath}",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "openocd",
            "serverpath": "${command:raspberry-pi-pico.getOpenOCDRoot}/openocd",
            "gdbPath": "${command:raspberry-pi-pico.getGDBPath}",
            "device": "${command:raspberry-pi-pico.getChipUppercase}",
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/${command:raspberry-pi-pico.getTarget}.cfg"
            ],
            "svdFile": "${userHome}/.pico-sdk/sdk/2.3.1/src/${command:raspberry-pi-pico.getChip}/hardware_regs/${command:raspberry-pi-pico.getChipUppercase}.svd",
            "runToEntryPoint": "main",
            // Fix for no_flash binaries, where monitor reset halt doesn't do what is expected
            // Also works fine for flash binaries
            "overrideLaunchCommands": [
                "monitor reset halt",
                "monitor program \"${command:raspberry-pi-pico.launchTargetPath}\" verify 0x2000",
                // The image is try-before-you-buy: a plain reset ignores it until it is bought.
                // Leave a flash-update reboot vector for slot A in watchdog scratch (PSM WDSEL,
                // scratch2..7, see furi_hal_power_reboot_to_partition); the reset below keeps it.
                "monitor mww 0x40018008 0x01fffff3",
                "monitor mww 0x400d8014 0x10002000",
                "monitor mww 0x400d8018 0",
                "monitor mww 0x400d801c 0xb007c0d3",
                "monitor mww 0x400d8020 0xfffffffe",
                "monitor mww 0x400d8024 4",
                "monitor mww 0x400d8028 0xb007c0d3",
                "monitor reset halt"
            ],
            "openOCDLaunchCommands": [
                "adapter speed 5000",
                "rp2350.dap.core0 configure -event gdb-detach { resume }",
                "rp2350.dap.core1 configure -event gdb-detach { resume }"
            ],
            "rttConfig": {
                "enabled": true,
                "address": "auto",
                "clearSearch": false,
                "polling_interval": 20,
                "rtt_start_retry": 20000,
                "decoders": [
                    {
                        "label": "Flipper One Logs",
                        "port": 0,
                        "timestamp": false,
                        "type": "console"
                    }
                ]
            },
        },
        {
            "name": "Pico Debug Attach",
            "cwd": "${command:raspberry-pi-pico.getOpenOCDRoot}/scripts",
            "executable": "${command:raspberry-pi-pico.launchTargetPath}",
            "request": "attach",
            "type": "cortex-debug",
            "servertype": "openocd",
            "serverpath": "${command:raspberry-pi-pico.getOpenOCDRoot}/openocd",
            "gdbPath": "${command:raspberry-pi-pico.getGDBPath}",
            "device": "${command:raspberry-pi-pico.getChipUppercase}",
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/${command:raspberry-pi-pico.getTarget}.cfg"
            ],
            "svdFile": "${userHome}/.pico-sdk/sdk/2.3.1/src/${command:raspberry-pi-pico.getChip}/hardware_regs/${command:raspberry-pi-pico.getChipUppercase}.svd",
            "openOCDLaunchCommands": [
                "adapter speed 5000",
                "rp2350.dap.core0 configure -event gdb-detach { resume }",
                "rp2350.dap.core1 configure -event gdb-detach { resume }"
            ],
            "rttConfig": {
                "enabled": true,
                "address": "auto",
                "clearSearch": false,
                "polling_interval": 20,
                "rtt_start_retry": 20000,
                "decoders": [
                    {
                        "label": "Flipper One Logs",
                        "port": 0,
                        "timestamp": false,
                        "type": "console"
                    }
                ]
            },
        },
        {
            "name": "Pico Debug (FreeRTOS)",
            "cwd": "${command:raspberry-pi-pico.getOpenOCDRoot}/scripts",
