{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug",
            "cwd": "${workspaceFolder}/.toolchain/tools/openocd/scripts",
            "executable": "${command:cmake.launchTargetPath}",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "openocd",
            "serverpath": "${workspaceFolder}/.toolchain/tools/openocd/openocd",
            "armToolchainPath": "${workspaceFolder}/.toolchain/tools/arm-none-eabi-gcc/bin",
            "device": "RP2350",
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "${workspaceFolder}/scripts/agent_tools/openocd/flipperone-mcu.cfg"
            ],
            "svdFile": "${workspaceFolder}/.toolchain/pico-sdk/src/rp2350/hardware_regs/RP2350.svd",
            "runToEntryPoint": "main",
            "overrideLaunchCommands": [
                "monitor reset halt",
                "monitor program \"${command:cmake.getLaunchTargetPath}\" verify 0x2000",
                // Boot the try-before-you-buy image as after an update
                "monitor f1_stage_tbyb 0x10002000",
                "monitor reset halt"
            ],
            "openOCDLaunchCommands": [
                "adapter speed 5000",
                "rp2350.cm0 configure -event gdb-detach { resume }",
                "rp2350.cm1 configure -event gdb-detach { resume }"
            ],
            "rttConfig": {
                "enabled": true,
                "address": "auto",
                "clearSearch": false,
                "polling_interval": 20,
                "rtt_start_retry": 20000,
                "decoders": [
                    {
                        "label": "Flipper One Logs",
                        "port": 0,
                        "timestamp": false,
                        "type": "console"
                    }
                ]
            }
        },
        {
            "name": "Debug Attach",
