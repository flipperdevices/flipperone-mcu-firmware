{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile Project",
            "type": "cmake",
            "command": "build",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Run Project",
            "type": "process",
            "command": "${userHome}/.flipperone-mcu-toolchain/current/tools/picotool/picotool",
            "group": "build",
            "dependsOn": "Compile Project",
            "args": [
                "load",
                "${command:cmake.getLaunchTargetPath}",
                "-fx"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "Write partition table",
            "type": "process",
            "command": "${userHome}/.flipperone-mcu-toolchain/current/tools/picotool/picotool",
            "group": "build",
            "dependsOn": "Compile Project",
            "args": [
                "load",
                "${command:cmake.getLaunchTargetDirectory}/partition_table.uf2",
                "-fvx"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "Flash",
            "type": "process",
            "command": "${userHome}/.flipperone-mcu-toolchain/current/tools/openocd/openocd",
            "group": "build",
            "dependsOn": "Compile Project",
            "args": [
                "-s",
                "${userHome}/.flipperone-mcu-toolchain/current/tools/openocd/scripts",
                "-f",
                "interface/cmsis-dap.cfg",
                "-f",
                "target/rp2350.cfg",
                "-c",
                "set BUILD_DIR {${command:cmake.getLaunchTargetDirectory}}",
                "-f",
                "targets/flash.tcl"
            ],
            "problemMatcher": []
        }
    ]
}
