{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "detail": "Build the preset selected in CMake Tools",
            "type": "cmake",
            "command": "build",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Build f2",
            "detail": "Configure and build the f2-release preset",
            "type": "process",
            "command": "${workspaceFolder}/.toolchain/tools/cmake/bin/cmake",
            "windows": {"command": "${workspaceFolder}/.toolchain/tools/cmake/bin/cmake.exe"},
            "args": ["--workflow", "--preset", "f2-release"],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Build f2 recovery",
            "detail": "Configure and build the f2-recovery preset: firmware and recovery.uf2",
            "type": "process",
            "command": "${workspaceFolder}/.toolchain/tools/cmake/bin/cmake",
            "windows": {"command": "${workspaceFolder}/.toolchain/tools/cmake/bin/cmake.exe"},
            "args": ["--workflow", "--preset", "f2-recovery"],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Build f2 debug",
            "detail": "Configure and build the f2-debug preset",
            "type": "process",
            "command": "${workspaceFolder}/.toolchain/tools/cmake/bin/cmake",
            "windows": {"command": "${workspaceFolder}/.toolchain/tools/cmake/bin/cmake.exe"},
            "args": ["--workflow", "--preset", "f2-debug"],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Build f1",
            "detail": "Configure and build the f1-release preset",
            "type": "process",
            "command": "${workspaceFolder}/.toolchain/tools/cmake/bin/cmake",
            "windows": {"command": "${workspaceFolder}/.toolchain/tools/cmake/bin/cmake.exe"},
            "args": ["--workflow", "--preset", "f1-release"],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Build f1 debug",
            "detail": "Configure and build the f1-debug preset",
            "type": "process",
            "command": "${workspaceFolder}/.toolchain/tools/cmake/bin/cmake",
            "windows": {"command": "${workspaceFolder}/.toolchain/tools/cmake/bin/cmake.exe"},
            "args": ["--workflow", "--preset", "f1-debug"],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Flash",
            "detail": "Build, then write the partition table and slot A over SWD and start the firmware",
            "type": "process",
            "command": "${workspaceFolder}/.toolchain/tools/python/bin/python3",
            "windows": {"command": "${workspaceFolder}/.toolchain/tools/python/python.exe"},
            "args": ["${workspaceFolder}/scripts/flash.py", "--build-dir", "${workspaceFolder}/build/current"],
            "group": "build",
            "dependsOn": "Build",
            "presentation": {"reveal": "always", "panel": "dedicated"},
            "problemMatcher": []
        },
        {
            "label": "Flash over USB (BOOTSEL)",
            "detail": "Build, then load the firmware with picotool into an MCU in BOOTSEL mode and start it",
            "type": "process",
            "command": "${workspaceFolder}/.toolchain/tools/picotool/picotool",
            "windows": {"command": "${workspaceFolder}/.toolchain/tools/picotool/picotool.exe"},
            "args": ["load", "${workspaceFolder}/build/current/flipperone-mcu-firmware.elf", "-fx"],
            "group": "build",
            "dependsOn": "Build",
            "presentation": {"reveal": "always", "panel": "dedicated"},
            "problemMatcher": []
        },
        {
            "label": "Write partition table over USB (BOOTSEL)",
            "detail": "Build, then load the partition table with picotool into an MCU in BOOTSEL mode",
            "type": "process",
            "command": "${workspaceFolder}/.toolchain/tools/picotool/picotool",
            "windows": {"command": "${workspaceFolder}/.toolchain/tools/picotool/picotool.exe"},
            "args": ["load", "${workspaceFolder}/build/current/partition_table.uf2", "-fvx"],
            "group": "build",
            "dependsOn": "Build",
            "presentation": {"reveal": "always", "panel": "dedicated"},
            "problemMatcher": []
        }
    ]
}
