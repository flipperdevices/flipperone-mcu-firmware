{
    // Tool paths: picotool and openocd are resolved by the Pico extension from the
    // sdkVersion/toolchainVersion/picotoolVersion header in CMakeLists.txt, which
    // is the single place those versions live. The extension has no such command
    // for cmake and ninja, so their paths below still carry a version and have to
    // be kept in sync with settings.json by hand.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile Project",
            "type": "process",
            "isBuildCommand": true,
            "command": "${userHome}/.pico-sdk/ninja/v1.12.1/ninja",
            "args": [
                "-C",
                "${workspaceFolder}/build"
            ],
            "windows": {
                "command": "${env:USERPROFILE}/.pico-sdk/ninja/v1.12.1/ninja.exe"
            },
            "problemMatcher": []
        },
        {
            "label": "Run Project",
            "type": "process",
            "command": "${command:raspberry-pi-pico.getPicotoolPath}",
            "group": "build",
            "dependsOn": "Compile Project",
            "args": [
                "load",
                "${command:raspberry-pi-pico.launchTargetPath}",
                "-fx"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "Write partition table",
            "type": "process",
            "command": "${command:raspberry-pi-pico.getPicotoolPath}",
            "group": "build",
            "dependsOn": "Compile Project",
            "args": [
                "load",
                "build/partition_table.uf2",
                "-fvx"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "Flash",
            "type": "process",
            "command": "${command:raspberry-pi-pico.getOpenOCDRoot}/openocd",
            "group": "build",
            "dependsOn": "Compile Project",
            "args": [
                "-s",
                "${command:raspberry-pi-pico.getOpenOCDRoot}/scripts",
                "-f",
                "interface/cmsis-dap.cfg",
                "-f",
                "target/${command:raspberry-pi-pico.getTarget}.cfg",
                "-f",
                "targets/flash.tcl"
            ],
            "problemMatcher": []
        },
        {
            // Reconfigures the one build directory for another board. Everything
            // else keeps working unchanged: the executable is always named after
            // project(), so the compile, flash and debug entries never mention a
            // target. Switching costs a full rebuild.
            "label": "Select Target",
            "detail": "Reconfigure the build for a different hardware target",
            "type": "process",
            "command": "${userHome}/.pico-sdk/cmake/v3.31.5/bin/cmake",
            "group": "build",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build",
                "-G",
                "Ninja",
                "-DFW_TARGET=${input:fwTarget}"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": [],
            "windows": {
                "command": "${env:USERPROFILE}/.pico-sdk/cmake/v3.31.5/bin/cmake.exe"
            }
        }
    ],
    "inputs": [
        {
            // One entry per directory under targets/ that has a target.cmake.
            // A name that is not there fails the configure with the list of the
            // ones that are.
            "id": "fwTarget",
            "type": "pickString",
            "description": "Hardware target",
            "default": "f1",
            "options": [
                "f1",
                "f2"
            ]
        }
    ]
}