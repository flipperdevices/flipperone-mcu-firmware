{
    "version": "2.0.0",
    "tasks": [
        {
            // On Linux and macOS every task goes through the Makefile, which
            // resolves the SDK, toolchain and flashing tools the same way a
            // terminal build does. Windows calls the tools installed by the Pico
            // extension directly.
            "label": "Compile Project",
            "type": "shell",
            "isBuildCommand": true,
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "command": "make",
            "args": [],
            "windows": {
                "command": "${env:USERPROFILE}/.pico-sdk/ninja/v1.12.1/ninja.exe",
                "args": [
                    "-C",
                    "${workspaceFolder}/build"
                ]
            },
            "problemMatcher": [ ]
        },
        {
            "label": "Run Project",
            "type": "shell",
            "command": "make",
            "args": [
                "load"
            ],
            "group": "build",
            "dependsOn": "Compile Project",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": [ ],
            "windows": {
                "command": "${env:USERPROFILE}/.pico-sdk/picotool/2.3.1/picotool/picotool.exe",
                "args": [
                    "load",
                    "${command:raspberry-pi-pico.launchTargetPath}",
                    "-fx"
                ]
            }
        },
        {
            "label": "Write partition table",
            "type": "shell",
            "command": "make",
            "args": [
                "load-partition-table"
            ],
            "group": "build",
            "dependsOn": "Compile Project",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": [ ],
            "windows": {
                "command": "${env:USERPROFILE}/.pico-sdk/picotool/2.3.1/picotool/picotool.exe",
                "args": [
                    "load",
                    "build/partition_table.uf2",
                    "-fvx"
                ]
            }
        },
        {
            "label": "Flash",
            "type": "shell",
            "command": "make",
            "args": [
                "flash"
            ],
            "group": "build",
            "dependsOn": "Compile Project",
            "problemMatcher": [ ],
            "windows": {
                "command": "${env:USERPROFILE}/.pico-sdk/openocd/0.12.0+dev/openocd.exe",
                "args": [
                    "-s",
                    "${env:USERPROFILE}/.pico-sdk/openocd/0.12.0+dev/scripts",
                    "-f",
                    "interface/cmsis-dap.cfg",
                    "-f",
                    "target/${command:raspberry-pi-pico.getTarget}.cfg",
                    "-f",
                    "targets/flash.tcl"
                ]
            }
        },
        {
            // Reconfigures the one build directory for another board. Everything
            // else keeps working unchanged: the executable is always named after
            // project(), so the compile, flash and debug entries never mention a
            // target. Switching costs a full rebuild.
            "label": "Select Target",
            "detail": "Reconfigure the build for a different hardware target",
            "type": "shell",
            "command": "make",
            "args": [
                "configure",
                "FW_TARGET=${input:fwTarget}"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": [],
            "windows": {
                "command": "${env:USERPROFILE}/.pico-sdk/cmake/v3.31.5/bin/cmake.exe",
                "args": [
                    "-S",
                    "${workspaceFolder}",
                    "-B",
                    "${workspaceFolder}/build",
                    "-G",
                    "Ninja",
                    "-DFW_TARGET=${input:fwTarget}"
                ]
            }
        }
    ],
    "inputs": [
        {
            // One entry per directory under targets/ that has a target.cmake.
            // A name that is not there fails the configure with the list of the
            // ones that are.
            "id": "fwTarget",
            "type": "pickString",
            "description": "Hardware target",
            "default": "f2",
            "options": [
                "f1",
                "f2"
            ]
        }
    ]
}
