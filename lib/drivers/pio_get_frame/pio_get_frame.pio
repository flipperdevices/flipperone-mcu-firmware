; pio_get_frame.pio
; High-speed SPI slave frame reader using PIO.
;
; Captures the external CPU's display frames (L8 grayscale, 8-bit) bit by bit
; on the SCK clock and DMA's them into a double buffer. A frame is delimited
; by the CS pin: while CS is low the state machine samples bits on the SCK
; rising edge; when CS goes high the C driver stops the SM, hands the filled
; buffer to the callback and switches to the next double buffer.
;
; "cpu spi" bus pins (RP2350):
;   DATA = IN base pin (external master MOSI) -> GPIO 28
;   SCK  = external clock (WAIT GPIO)         -> GPIO 26
;   CS   = frame select (JMP pin, WAIT GPIO)  -> GPIO 25
;
; SPI mode 3 (CPOL=1, CPHA=1), MSB-first: data is sampled on the SCK rising edge.

.program pio_get_frame
.origin 0

; Wait for CS low (frame start)
wait 0 gpio 25

.wrap_target
    ; Wait for SCK rising edge (sample point)
    wait 1 gpio 26
    ; Sample one data bit, MSB-first byte assembly (autopush 8)
    in pins, 1
    ; Wait for SCK falling edge (avoid double sampling)
    wait 0 gpio 26
    ; If CS went high -> frame complete, exit the loop
    jmp pin frame_done
.wrap

; Stalled here; the C driver disables the SM and re-arms for the next frame.
frame_done:
    nop