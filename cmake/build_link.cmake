# Points build/current at FW_BUILD_DIR when that is a build/<preset> directory, for
# clangd, the debugger and tools. Runs at configure time and, with -P, on every build.
cmake_path(GET FW_BUILD_DIR PARENT_PATH _fw_parent)
cmake_path(GET FW_BUILD_DIR FILENAME _fw_name)
if(NOT _fw_parent STREQUAL "${FW_SOURCE_DIR}/build" OR _fw_name STREQUAL "current")
    return()
endif()
set(_fw_link "${_fw_parent}/current")
if(CMAKE_HOST_WIN32)
    # A junction needs no symlink privilege; rmdir drops a link, never a full directory
    file(TO_NATIVE_PATH "${_fw_link}" _fw_link_native)
    file(TO_NATIVE_PATH "${FW_BUILD_DIR}" _fw_dir_native)
    execute_process(COMMAND cmd /c rmdir "${_fw_link_native}" OUTPUT_QUIET ERROR_QUIET)
    execute_process(COMMAND cmd /c mklink /J "${_fw_link_native}" "${_fw_dir_native}"
        RESULT_VARIABLE _fw_result OUTPUT_QUIET ERROR_QUIET)
elseif(IS_SYMLINK "${_fw_link}" OR NOT EXISTS "${_fw_link}")
    if(IS_SYMLINK "${_fw_link}")
        file(READ_SYMLINK "${_fw_link}" _fw_target)
        if(_fw_target STREQUAL _fw_name)
            return()
        endif()
    endif()
    file(CREATE_LINK "${_fw_name}" "${_fw_link}" RESULT _fw_result SYMBOLIC)
else()
    set(_fw_result "not a link")
endif()
if(NOT _fw_result EQUAL 0)
    message(WARNING "Cannot point ${_fw_link} at ${FW_BUILD_DIR}: ${_fw_result}")
endif()
