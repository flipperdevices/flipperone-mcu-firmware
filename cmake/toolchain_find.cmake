# Without the fbtenv environment (e.g. an IDE), use the pinned toolchain if installed.
if(NOT PICO_SDK_PATH AND NOT DEFINED ENV{PICO_SDK_PATH})
    file(READ "${CMAKE_CURRENT_LIST_DIR}/../toolchain.json" _fw_pin)
    string(JSON _fw_tag GET "${_fw_pin}" toolchain)
    if(DEFINED ENV{FLIPPERONE_TOOLCHAIN_HOME})
        set(_fw_home "$ENV{FLIPPERONE_TOOLCHAIN_HOME}")
    elseif(CMAKE_HOST_WIN32)
        set(_fw_home "$ENV{USERPROFILE}/.flipperone-mcu-toolchain")
    else()
        set(_fw_home "$ENV{HOME}/.flipperone-mcu-toolchain")
    endif()
    file(TO_CMAKE_PATH "${_fw_home}/${_fw_tag}" _fw_root)
    if(EXISTS "${_fw_root}/cmake/initial-cache.cmake")
        message(STATUS "Toolchain environment not set up, using ${_fw_root}")
        include("${_fw_root}/cmake/initial-cache.cmake")
        if(CMAKE_GENERATOR MATCHES "Ninja" AND NOT CMAKE_MAKE_PROGRAM)
            set(CMAKE_MAKE_PROGRAM "${_fw_root}/tools/ninja/bin/ninja${CMAKE_HOST_EXECUTABLE_SUFFIX}"
                CACHE FILEPATH "")
        endif()
    endif()
endif()
