{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Pico Debug",
            "cwd": "${userHome}/one/openocd/tcl",
            "executable": "${command:raspberry-pi-pico.launchTargetPath}",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "openocd",
            "serverpath": "${userHome}/one/openocd/src/openocd",
            "gdbPath": "${command:raspberry-pi-pico.getGDBPath}",
            "device": "${command:raspberry-pi-pico.getChipUppercase}",
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/rp2350.cfg"
            ],
            "svdFile": "${userHome}/.pico-sdk/sdk/2.2.0/src/${command:raspberry-pi-pico.getChip}/hardware_regs/${command:raspberry-pi-pico.getChipUppercase}.svd",
            "runToEntryPoint": "main",
            // Fix for no_flash binaries, where monitor reset halt doesn't do what is expected
            // Also works fine for flash binaries
            "overrideLaunchCommands": [
                "monitor reset halt",
                "monitor program \"${command:raspberry-pi-pico.launchTargetPath}\" verify 0x2000",
            ],
            "openOCDLaunchCommands": [
                "adapter speed 5000"
            ],
            "rttConfig": {
                "enabled": true,
                "address": "auto",
                "clearSearch": false,
                "polling_interval": 20,
                "rtt_start_retry": 20000,
                "decoders": [
                    {
                        "label": "Flipper One Logs",
                        "port": 0,
                        "timestamp": false,
                        "type": "console"
                    }
                ]
            },
        },
        {
            "name": "Pico Debug Attach",
            "cwd": "${userHome}/one/openocd/tcl",
            "executable": "${command:raspberry-pi-pico.launchTargetPath}",
            "request": "attach",
            "type": "cortex-debug",
            "servertype": "openocd",
            "serverpath": "${userHome}/one/openocd/src/openocd",
            "gdbPath": "${command:raspberry-pi-pico.getGDBPath}",
            "device": "${command:raspberry-pi-pico.getChipUppercase}",
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/rp2350.cfg"
            ],
            "svdFile": "${userHome}/.pico-sdk/sdk/2.2.0/src/${command:raspberry-pi-pico.getChip}/hardware_regs/${command:raspberry-pi-pico.getChipUppercase}.svd",
            "openOCDLaunchCommands": [
                "adapter speed 5000"
            ],
            "rttConfig": {
                "enabled": true,
                "address": "auto",
                "clearSearch": false,
                "polling_interval": 20,
                "rtt_start_retry": 20000,
                "decoders": [
                    {
                        "label": "Flipper One Logs",
                        "port": 0,
                        "timestamp": false,
                        "type": "console"
                    }
                ]
            },
        },
        {
            "name": "Pico Debug (FreeRTOS)",
            "cwd": "${userHome}/one/openocd/tcl",
            "executable": "${command:raspberry-pi-pico.launchTargetPath}",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "openocd",
            "serverpath": "${userHome}/one/openocd/src/openocd",
            "gdbPath": "${command:raspberry-pi-pico.getGDBPath}",
            "device": "${command:raspberry-pi-pico.getChipUppercase}",
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/rp2350.cfg",
                // "${workspaceFolder}/scripts/flash.tcl"
            ],
            "svdFile": "${userHome}/.pico-sdk/sdk/2.2.0/src/${command:raspberry-pi-pico.getChip}/hardware_regs/${command:raspberry-pi-pico.getChipUppercase}.svd",
            "rtos": "FreeRTOS",
            "runToEntryPoint": "main",
            // Fix for no_flash binaries, where monitor reset halt doesn't do what is expected
            // Also works fine for flash binaries
            "overrideLaunchCommands": [
                "monitor reset halt",
                // Load fw to slot A (0x10002000). Assume that partition table is already flashed and slot B is empty
                "monitor program \"${command:raspberry-pi-pico.launchTargetPath}\" verify 0x2000",
            ],
            "openOCDLaunchCommands": [
                "adapter speed 5000",
            ],
            "rttConfig": {
                "enabled": true,
                "address": "auto",
                "clearSearch": false,
                "polling_interval": 20,
                "rtt_start_retry": 20000,
                "decoders": [
                    {
                        "label": "Flipper One Logs",
                        "port": 0,
                        "timestamp": false,
                        "type": "console"
                    }
                ]
            },
        },
        {
            "name": "Pico Debug Attach (FreeRTOS)",
            "cwd": "${userHome}/one/openocd/tcl",
            "executable": "${command:raspberry-pi-pico.launchTargetPath}",
            "request": "attach",
            "type": "cortex-debug",
            "servertype": "openocd",
            "serverpath": "${userHome}/one/openocd/src/openocd",
            "gdbPath": "${command:raspberry-pi-pico.getGDBPath}",
            "device": "${command:raspberry-pi-pico.getChipUppercase}",
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/rp2350.cfg"
            ],
            "svdFile": "${userHome}/.pico-sdk/sdk/2.2.0/src/${command:raspberry-pi-pico.getChip}/hardware_regs/${command:raspberry-pi-pico.getChipUppercase}.svd",
            "rtos": "FreeRTOS",
            "openOCDLaunchCommands": [
                "adapter speed 5000"
            ],
            "rttConfig": {
                "enabled": true,
                "address": "auto",
                "clearSearch": false,
                "polling_interval": 20,
                "rtt_start_retry": 20000,
                "decoders": [
                    {
                        "label": "Flipper One Logs",
                        "port": 0,
                        "timestamp": false,
                        "type": "console"
                    }
                ]
            },
        },
    ]
}